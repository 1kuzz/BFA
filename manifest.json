{
  "manifest_version": 3,
  "name": "Bitrix24 Forms Analyzer",
  "version": "6.1.1",
  "description": "Control Center для аудита, безопасного массового редактирования, диффа и скоринга форм Bitrix24.",
  "permissions": ["storage", "downloads", "alarms", "scripting", "tabs"],
  "host_permissions": [
    "https://*.bitrix24.eu/*",
    "https://kasperskyform.eu/*",
    "https://*.kasperskyform.eu/*",
    "https://kasperskyform.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "core/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Bitrix24 Forms Analyzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "ui/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.bitrix24.eu/*",
        "https://kasperskyform.eu/*",
        "https://*.kasperskyform.eu/*",
        "https://kasperskyform.com/crm/webform/*"
      ],
      "js": ["core/content.js"],
      "run_at": "document_idle"
    }
  ]
}
